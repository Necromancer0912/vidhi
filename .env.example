# ─────────────────────────────────────────────────────────────────────────────
# NyayaBot / Vidhi — Environment Configuration
# Copy to .env and fill in your values. Every variable read by src/config.py
# is listed here; anything else is ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "ollama" (default, free via Ollama Cloud), "groq", "google", "vllm", "llamacpp"
LLM_PROVIDER=ollama
LLM_MODEL=gemma4:31b-cloud
LLM_FALLBACK_MODEL=gemini-2.0-flash
OLLAMA_LLM_BASE_URL=http://localhost:11434

# Groq fallback (free tier: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google AI Studio (only if LLM_PROVIDER=google or for the fallback model)
GOOGLE_API_KEY=

# OpenAI-compatible servers (only if LLM_PROVIDER=vllm / llamacpp)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_EMBED_URL=http://localhost:8081
LLAMACPP_API_KEY=
LLAMACPP_EMBED_MODEL=nomic-embed-text

# ── Embeddings ───────────────────────────────────────────────────────────────
EMBED_PROVIDER=ollama            # "ollama" | "llamacpp"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text   # 768-dim
EMBEDDING_DIM=768

# ── Vector DB & Reranker ─────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=legal_docs
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
ENABLE_RERANKER=false            # cross-encoder rerank in the chat pipeline

# ── Redis (local Docker or Upstash) ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# ── Translation ──────────────────────────────────────────────────────────────
DISABLE_INDICTRANS2=false        # true = use LLM-based translation only

# ── Observability (optional) ─────────────────────────────────────────────────
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nyayabot-dev
LANGCHAIN_TRACING_V2=true

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # "production" enforces JWT_SECRET
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000   # comma-separated origins for CORS
JWT_SECRET=                      # required in production; generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_EMAILS=                    # comma-separated emails granted the "pro" tier
GOOGLE_CLIENT_ID=                # same value as frontend VITE_GOOGLE_CLIENT_ID; Google tokens for other clients are refused
JWT_TTL_DAYS=7

# ── Abuse limits ─────────────────────────────────────────────
# Local proxies in front of uvicorn: 0 local dev · 1 Funnel (make run) · 2 Funnel + nginx (make scale)
TRUSTED_PROXY_HOPS=0
CLIENT_IP_HEADER=x-vercel-forwarded-for,x-client-ip   # visitor IP from Vercel / the Cloudflare worker
EDGE_RPM=240                     # requests/min per connecting address; forged headers can't dodge it
GUEST_DAILY_LIMIT=20             # chat requests per IP per day without an account
GUEST_GLOBAL_RPM=30              # chat requests per minute across all guests
ENABLE_API_DOCS=false            # expose /docs and /openapi.json

# ── RAG Tuning ───────────────────────────────────────────────────────────────
MAX_RETRIES=2
CRITIC_THRESHOLD=0.7
CRITIC_MIN_FAILURES=2
TOP_K_RETRIEVAL=20
TOP_K_RERANK=5
TOKEN_BUDGET=3000
CACHE_SIMILARITY_THRESHOLD=0.92
CACHE_VERSION=1                  # bump to invalidate all cached answers
MEMORY_TTL_SECONDS=1800
MEMORY_MAX_TURNS=10
